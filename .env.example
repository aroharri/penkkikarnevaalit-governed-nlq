# Optional. With a key, the LLM router is used (the default).
# Without one, the deterministic rule router runs instead, so the demo
# still works on a fresh clone.
#
# Tests NEVER call the API: they replay recorded responses from
# evals/cassettes/ so results are identical on every run.
ANTHROPIC_API_KEY=

# Where the local warehouse file is written.
DUCKDB_PATH=warehouse.duckdb
