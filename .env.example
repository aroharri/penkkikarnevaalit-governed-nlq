# Which model routes questions to metrics. Optional: with no key at all, the
# deterministic rule router runs, so a fresh clone works out of the box.
#
# Only the transport differs between these. The prompt, the parsing and every
# gate downstream are identical -- see nlq/providers.py.

# LLM_PROVIDER=gemini        # anthropic | gemini | groq | xai | openrouter | ollama

ANTHROPIC_API_KEY=
GEMINI_API_KEY=              # Google AI Studio: standing free tier, no card
GROQ_API_KEY=                # Groq the inference company, not Grok. Free tier.
XAI_API_KEY=                 # Grok. Sign-up credit only, no standing free tier.
OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434   # local, no key and no network

# Override the default model for a provider:
# LLM_MODEL_GEMINI=gemini-3.6-flash

# Tests NEVER call any of these. Responses are recorded to
# evals/cassettes/<provider>/ and replayed, so results are identical every run.
# Record with:  LLM_PROVIDER=gemini python evals/run_evals.py --record

DUCKDB_PATH=warehouse.duckdb
